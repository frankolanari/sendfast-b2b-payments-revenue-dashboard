# Local synthetic environment. Copy to .env:  cp .env.example .env
# Synthetic defaults only. Never put a real credential in this file or in .env (D12).

COMPOSE_PROJECT_NAME=sendfast

# Data Postgres (raw, staging, intermediate, analytics schemas; never `public`)
DATA_DB_HOST=localhost
DATA_DB_HOST_PORT=55432
DATA_DB_NAME=sendfast
DATA_DB_ADMIN_USER=sendfast_admin
DATA_DB_ADMIN_PASSWORD=synthetic-local-only
DATA_DB_SSLMODE=disable

# Database roles (deploy/sql/roles.sql). Synthetic local values only.
TRANSFORMER_USER=transformer
TRANSFORMER_PASSWORD=synthetic-transformer-local
BI_READER_PASSWORD=synthetic-bi-reader-local
CONFORMANCE_PASSWORD=synthetic-conformance-local

# The dashboard server connects as this role: the marts only, read-only.
BI_READER_USER=bi_reader
