# Cloud demo environment (Stage 10): Supabase Cloud + the dashboard server on Cloudflare Workers.
# Still synthetic data. Real values live in GitHub/Worker secrets, never in the repo.
# Production (real company) credentials never go here or anywhere CI can reach (D12).

# Data Postgres on Supabase (direct or session-mode connection, not transaction pooling)
DATA_DB_HOST=
DATA_DB_HOST_PORT=5432
DATA_DB_NAME=postgres
DATA_DB_ADMIN_USER=
DATA_DB_ADMIN_PASSWORD=
DATA_DB_SSLMODE=require

# Database roles: from the cloud secret store, never committed
TRANSFORMER_USER=transformer
TRANSFORMER_PASSWORD=
BI_READER_PASSWORD=
CONFORMANCE_PASSWORD=

# The dashboard server connects as this role: the marts only, read-only.
BI_READER_USER=bi_reader
