# Cloud demo environment (Stage 10): Supabase Cloud + Metabase on a VPS via Coolify.
# Still synthetic data. Real values live in GitHub/Coolify/Worker secrets, never in the repo.
# Production (real company) credentials never go here or anywhere CI can reach (D12).

# Data Postgres on Supabase (direct or session-mode connection, not transaction pooling)
DATA_DB_HOST=
DATA_DB_HOST_PORT=5432
DATA_DB_NAME=postgres
DATA_DB_ADMIN_USER=
DATA_DB_ADMIN_PASSWORD=
DATA_DB_SSLMODE=require

# Metabase application database (on the VPS)
MB_APP_DB_NAME=metabase
MB_APP_DB_USER=metabase
MB_APP_DB_PASSWORD=

# Metabase
MB_SITE_URL=
