{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema_contract.schema.json",
  "title": "SendFast schema contract",
  "description": "Shape of contract/schema_contract.yml. Cross-references (keys, foreign keys) are checked by scripts/contract_check.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "conventions", "tables"],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "conventions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/table" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source",
        "description",
        "grain",
        "primary_key",
        "columns"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^stg_[a-z]+__[a-z][a-z0-9_]*$"
        },
        "source": { "enum": ["crm", "billing", "ledger", "rates"] },
        "description": { "type": "string", "minLength": 1 },
        "grain": { "type": "string", "minLength": 1 },
        "optional": { "type": "boolean" },
        "primary_key": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/column" }
        },
        "foreign_keys": {
          "type": "array",
          "items": { "$ref": "#/$defs/foreign_key" }
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "nullable", "description"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "type": {
          "enum": [
            "text",
            "integer",
            "bigint",
            "numeric",
            "boolean",
            "date",
            "timestamptz"
          ]
        },
        "nullable": { "type": "boolean" },
        "description": { "type": "string", "minLength": 1 },
        "allowed_values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "pattern": { "type": "string", "format": "regex" }
      }
    },
    "foreign_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "references"],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "references": {
          "type": "object",
          "additionalProperties": false,
          "required": ["table", "columns"],
          "properties": {
            "table": { "type": "string" },
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/identifier" }
            }
          }
        }
      }
    }
  }
}
